    "statusBar.foreground": "#e7e7e7",
    "statusBarItem.hoverBackground": "#000056",
    "statusBarItem.remoteBackground": "#000023",
    "statusBarItem.remoteForeground": "#e7e7e7",
    "titleBar.activeBackground": "#000023",
    "titleBar.activeForeground": "#e7e7e7",
    "titleBar.inactiveBackground": "#00002399",
    "titleBar.inactiveForeground": "#e7e7e799"
